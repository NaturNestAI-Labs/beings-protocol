# Template: kit-install.sh (skills/runner) writes ~/.config/systemd/user/@BEING_NAME@-update.timer. Off until enabled.
[Unit]
Description=@BEING_NAME@ looks for a new Beings kit release once a day

[Timer]
OnCalendar=*-*-* 10:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
